SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8081

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/motodigo_core
SPRING_DATASOURCE_USERNAME=motodigo
SPRING_DATASOURCE_PASSWORD=change-me-local-only

JWT_SECRET=change-me-to-at-least-32-bytes-for-hs256
JWT_ISSUER_URL=http://localhost:8081
JWT_AUDIENCE=motodi-go-api
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

OTP_PROVIDER=log
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_DAILY_LIMIT_PER_PHONE=10
OTP_DAILY_LIMIT_PER_IP=50
OTP_PEPPER=change-me-otp-pepper

# Twilio (primary when OTP_PROVIDER=twilio, with Africa's Talking as fallback)
# Auth: either AUTH_TOKEN alone, or API_KEY_SID + API_KEY_SECRET.
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_FROM_NUMBER=your-twilio-phone-number
TWILIO_CONNECT_TIMEOUT_MS=5000
TWILIO_READ_TIMEOUT_MS=10000

AFRICAS_TALKING_BASE_URL=https://api.sandbox.africastalking.com
AFRICAS_TALKING_USERNAME=Sandbox
AFRICAS_TALKING_API_KEY=your-api-key
# Leave empty in sandbox. Use AFRICASTKNG in live until MOTODIGO is approved.
AFRICAS_TALKING_SENDER_ID=
AFRICAS_TALKING_ENQUEUE=true
AFRICAS_TALKING_CONNECT_TIMEOUT_MS=3000
AFRICAS_TALKING_READ_TIMEOUT_MS=5000

KYC_STORAGE_ENDPOINT=http://localhost:9000
KYC_STORAGE_REGION=us-east-1
KYC_STORAGE_BUCKET=motodigo-kyc
KYC_STORAGE_ACCESS_KEY=minioadmin
KYC_STORAGE_SECRET_KEY=minioadmin
KYC_STORAGE_PATH_STYLE=true
KYC_ENCRYPTION_ACTIVE_KEY_ID=local
KYC_ENCRYPTION_KEYS_LOCAL=bW90b2RpZ28tbG9jYWwta3ljLWtleS0zMi1ieXRlISE=
KYC_CHECKSUM_PEPPER=change-me-kyc-checksum-pepper
KYC_MAX_FILE_SIZE_BYTES=5242880

GIS_ROUTES_YAOUNDE_PATH=./data/gis/routes_yaounde.gpkg

GEO_STACK_PHOTON_ENABLED=false
GEO_STACK_PHOTON_BASE_URL=http://localhost:2322
GEO_STACK_PHOTON_TIMEOUT_MS=1200
GEO_STACK_PHOTON_CONTROL_URL=
GEO_STACK_VALHALLA_ENABLED=false
GEO_STACK_VALHALLA_BASE_URL=http://localhost:8002
GEO_STACK_VALHALLA_TIMEOUT_MS=12000
GEO_STACK_VALHALLA_COSTING=motorcycle
GEO_STACK_VALHALLA_ALTERNATES=2
